sequenceDiagram
  autonumber
  actor Usuario
  participant Front as Frontend React
  participant Auth as AuthController
  participant UserSvc as UsuariosService
  participant Crypto as bcrypt
  participant Jwt as JwtService
  participant Audit as AuditLog

  Usuario->>Front: Ingresa credenciales
  Front->>Auth: POST /api/auth/login
  Auth->>Auth: Valida DTO
  Auth->>UserSvc: Buscar por email
  alt Usuario no encontrado
    UserSvc-->>Auth: null
    Auth-->>Front: 401 credenciales invalidas
    Front-->>Usuario: Muestra error
  else Usuario inactivo
    UserSvc-->>Auth: Usuario inactivo
    Auth-->>Front: 403 usuario inactivo
    Front-->>Usuario: Muestra bloqueo
  else Usuario activo
    UserSvc-->>Auth: Usuario activo
    Auth->>Crypto: Comparar hash
    Crypto-->>Auth: Resultado
  end

  alt Password valido
    Auth->>Jwt: Firmar payload
    Jwt-->>Auth: access_token
    Auth->>Audit: Registrar LOGIN
    Audit-->>Auth: Registro confirmado
    Auth-->>Front: 200 token y perfil
    Front->>Front: Guardar token en localStorage
    Front-->>Usuario: Redirige segun rol
  else Password invalido
    Auth-->>Front: 401 credenciales invalidas
    Front-->>Usuario: Muestra error
  end
