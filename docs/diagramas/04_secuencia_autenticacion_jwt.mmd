sequenceDiagram
  autonumber
  actor U as Usuario
  participant F as Frontend React
  participant A as API NestJS
  participant Auth as AuthServicio
  participant DB as PostgreSQL
  participant Audit as AuditLog

  U->>F: Ingresa email y contrasena
  F->>A: POST /api/auth/login
  A->>Auth: validarCredenciales(email, contrasena)
  Auth->>DB: Buscar usuario + rol + password_hash
  DB-->>Auth: Usuario encontrado
  Auth->>Auth: Comparar bcrypt
  alt Credenciales validas
    Auth->>Auth: Firmar access_token y refresh_token
    Auth->>DB: Guardar sesion
    Auth->>Audit: Registrar LOGIN
    Auth-->>A: Tokens + rol
    A-->>F: 200 OK
    F->>F: Guardar tokens
    F-->>U: Redireccion por rol
  else Credenciales invalidas
    Auth-->>A: Error de autenticacion
    A-->>F: 401/400
    F-->>U: Mostrar mensaje de error
  end
