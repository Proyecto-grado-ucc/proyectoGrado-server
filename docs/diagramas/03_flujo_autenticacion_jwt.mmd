flowchart TD
  A[Usuario ingresa email y contrasena] --> B[Frontend envia POST /api/auth/login]
  B --> C{Backend valida DTO}
  C -- Invalido --> X[Retorna 400 Bad Request]
  C -- Valido --> D[Buscar usuario por email]
  D --> E{Usuario activo existe?}
  E -- No --> Y[Retorna credenciales incorrectas]
  E -- Si --> F[Comparar contrasena con hash bcrypt]
  F --> G{Hash coincide?}
  G -- No --> Y
  G -- Si --> H[Generar access token JWT]
  H --> I[Generar refresh token]
  I --> J[Registrar sesion y auditoria]
  J --> K[Frontend guarda tokens y rol]
  K --> L{Rol}
  L -- Administrador --> M[Redirigir a /admin/dashboard]
  L -- Docente --> N[Redirigir a /docente/dashboard]
  L -- Estudiante --> O[Redirigir a /estudiante/dashboard]

  classDef ok fill:#dcfce7,stroke:#16a34a,color:#14532d
  classDef warn fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
  class M,N,O ok
  class X,Y warn
