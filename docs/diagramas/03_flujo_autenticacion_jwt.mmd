flowchart TD
  A["Credenciales"] --> B["POST /auth/login"]
  B --> C{"DTO valido"}
  C -- "No" --> X["400 Bad Request"]
  C -- "Si" --> D["Buscar usuario"]
  D --> E{"Usuario activo"}
  E -- "No" --> Y["Error de acceso"]
  E -- "Si" --> F["Validar bcrypt"]
  F --> G{"Coincide"}
  G -- "No" --> Y
  G -- "Si" --> H["Emitir JWT"]
  H --> I["Crear sesion"]
  I --> J["Guardar tokens"]
  J --> K{"Rol"}
  K --> L["Admin"]
  K --> M["Docente"]
  K --> N["Estudiante"]

  classDef ok fill:#dcfce7,stroke:#16a34a,color:#14532d
  classDef err fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
  class L,M,N ok
  class X,Y err
