flowchart TB
  Admin["Administrador"]:::actor
  Docente["Docente"]:::actor
  Estudiante["Estudiante"]:::actor

  subgraph CAL["Sistema CAL"]
    subgraph Seguridad["Seguridad"]
      Login(("Autenticarse"))
      Recuperar(("Recuperar clave"))
    end

    subgraph Gestion["Gestion administrativa"]
      Usuarios(("Gestionar usuarios"))
      Maestros(("Gestionar datos maestros"))
      Formularios(("Gestionar formularios"))
      AsignarEval(("Asignar evaluaciones"))
      GenerarHorario(("Generar horario IA"))
      EjecutarKdd(("Ejecutar KDD"))
      Auditoria(("Consultar auditoria"))
    end

    subgraph Consulta["Consulta academica"]
      ConsultarHorario(("Consultar horario"))
      ConsultarResultados(("Consultar resultados"))
    end

    subgraph Participacion["Participacion estudiante"]
      ResponderEval(("Responder evaluacion docente"))
      Inscripcion(("Inscribirse a grupo"))
    end
  end

  Admin --> Login
  Docente --> Login
  Estudiante --> Login
  Admin --> Recuperar
  Docente --> Recuperar
  Estudiante --> Recuperar

  Admin --> Usuarios
  Admin --> Maestros
  Admin --> Formularios
  Admin --> AsignarEval
  Admin --> GenerarHorario
  Admin --> EjecutarKdd
  Admin --> Auditoria

  Docente --> ConsultarHorario
  Docente --> ConsultarResultados

  Estudiante --> ConsultarHorario
  Estudiante --> ResponderEval
  Estudiante --> Inscripcion

  Recuperar -. "extend" .-> Login
  AsignarEval -. "include" .-> Formularios
  GenerarHorario -. "include" .-> Maestros
  EjecutarKdd -. "include" .-> ResponderEval

  classDef actor fill:#fff,stroke:#111827,stroke-width:2px,color:#111827
