flowchart LR
  A["Datos de entrada"] --> B["Validar insumos"]
  B --> C{"Insumos completos"}
  C -- "No" --> X["Reportar faltantes"]
  C -- "Si" --> D["Crear poblacion inicial"]
  D --> E["Evaluar restricciones"]
  R["Docentes, aulas, franjas y grupos"] -->|parametros| E
  E --> F["Calcular fitness"]
  F --> G["Seleccion"]
  G --> H["Cruce y mutacion"]
  H --> I["Busqueda tabu local"]
  I --> J{"Mejora candidato"}
  J -- "Si" --> K["Guardar mejor candidato"]
  J -- "No" --> L["Actualizar lista tabu"]
  K --> M{"Max generaciones o fitness objetivo"}
  L --> M
  M -- "No" --> G
  M -- "Si" --> N{"Solucion aceptable"}
  N -- "Si" --> O["Horario optimizado"]
  N -- "No" --> P["Error de convergencia"]
  O --> Q["Persistir resultado"]
