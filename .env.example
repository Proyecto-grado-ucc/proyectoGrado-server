# Entorno Railway / produccion
NODE_ENV=production
# Railway inyecta PORT automaticamente. Para local puedes usar PORT=3000.
# PORT=3000

# PostgreSQL en Railway. No usar DB_HOST=db en Railway.
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_USUARIO=${{Postgres.PGUSER}}
DB_CONTRASENA=${{Postgres.PGPASSWORD}}
DB_NOMBRE=${{Postgres.PGDATABASE}}

# Railway tambien puede usar DATABASE_URL en lugar de DB_*
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/base
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Desarrollo local alternativo:
# NODE_ENV=development
# PORT=3000
# DB_HOST=localhost
# DB_PORT=5432
# DB_USUARIO=cal_usuario
# DB_CONTRASENA=cal_contrasena
# DB_NOMBRE=cal_db
#
# Si usas docker-compose local y el contenedor backend esta en la misma red:
# DB_HOST=db

# TypeORM
# En produccion siempre queda desactivado aunque esta variable sea true.
TYPEORM_SYNCHRONIZE=true

# JWT
JWT_SECRETO=cambiar_por_un_valor_aleatorio_de_32_caracteres_o_mas
JWT_EXPIRACION=15m
JWT_REFRESCO_SECRETO=cambiar_por_otro_valor_aleatorio_de_32_caracteres_o_mas
JWT_REFRESCO_EXPIRACION=7d

# Seguridad
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Admin inicial. Usar solo al ejecutar npm run seed:admin.
ADMIN_EMAIL=admin@example.com
ADMIN_NOMBRE=Administrador CAL
ADMIN_CONTRASENA=cambiar-por-una-contrasena-segura
# ADMIN_ACTUALIZAR_CONTRASENA=true

# IA opcional
GEMINI_API_KEY=
