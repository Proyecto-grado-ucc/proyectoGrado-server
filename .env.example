# Entorno Railway / produccion
NODE_ENV=production
# Railway inyecta PORT automaticamente. Para local puedes usar PORT=3000.
# PORT=3000

# PostgreSQL en Railway.
# Prioridad 1: DATABASE_URL si Railway la expone para el servicio Postgres.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Prioridad 2: variables PG* del servicio Postgres de Railway.
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}
PGDATABASE=${{Postgres.PGDATABASE}}

# Compatibilidad local opcional si no usas DATABASE_URL ni PG*.
# DB_HOST=tu-host-postgres-local
# DB_PORT=5432
# DB_USUARIO=cal_usuario
# DB_CONTRASENA=cal_contrasena
# DB_NOMBRE=cal_database

# SSL: en NODE_ENV=production se activa automaticamente.
# DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# TypeORM
# En produccion siempre queda desactivado aunque esta variable sea true.
TYPEORM_SYNCHRONIZE=true

# JWT
JWT_SECRETO=cambiar_por_un_valor_aleatorio_de_32_caracteres_o_mas
JWT_EXPIRACION=15m
JWT_REFRESCO_SECRETO=cambiar_por_otro_valor_aleatorio_de_32_caracteres_o_mas
JWT_REFRESCO_EXPIRACION=7d

# Seguridad
BCRYPT_ROUNDS=12
CORS_ORIGINS=https://tu-frontend.example.com
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Admin inicial. Usar solo al ejecutar npm run seed:admin.
ADMIN_EMAIL=admin@example.com
ADMIN_NOMBRE=Administrador CAL
ADMIN_CONTRASENA=cambiar-por-una-contrasena-segura
# ADMIN_ACTUALIZAR_CONTRASENA=true

# IA opcional
GEMINI_API_KEY=
